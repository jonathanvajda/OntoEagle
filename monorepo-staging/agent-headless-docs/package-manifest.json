{
  "schemaVersion": 1,
  "policy": {
    "canonicalCapabilityContract": "JavaScript package API",
    "canonicalUserProductSurface": "Browser app",
    "entrypointRule": "Import only from package src/index.js during staging or mirrored shared package index.js in browser apps.",
